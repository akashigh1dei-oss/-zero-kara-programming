{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-kara-prog",
  "compatibility_date": "2026-09-18",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
